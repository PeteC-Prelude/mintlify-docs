  "keyFeatures": [
    "Endpoint AI agent inventory and visibility across Windows and macOS fleets",
    "Real-time capture of AI prompts, sessions, and token usage across all major AI providers",
    "Activity Clustering — semantic grouping of AI activity into named topic clusters",
    "Endpoint Explorer dashboard with fleet-wide metrics, trace logs, and execution logs",
    "Natural-language chat interface to query the analytics graph",
    "Role-based access control with Admin and Member roles",
    "Identity integration with Microsoft Entra ID, Google Workspace, and Okta",
    "MDM deployment support for Jamf, Intune, and Tanium",
    "Claude Enterprise integration via Anthropic Compliance API",
    "MCP server for querying observability data from AI coding tools",
    "Custom AI provider capture rules",
    "Skills — uploadable behavioral units for automation"
  ],
  "publicApiSurface": [
    "MCP tool: analytics_query",
    "MCP tool: analytics_describe_schema",
    "MCP endpoint: https://mcp.prod.originhq.com/mcp",
    "Agent registration endpoint: https://registration.prod.originhq.com",
    "Agent heartbeat endpoint: https://endpoint.prod.originhq.com",
    "Windows silent install: msiexec /i origin-installer.msi /quiet PROVISIONING_JWT=<token>",
    "macOS uninstall: sudo /Applications/Origin.app/Contents/Resources/uninstall.sh",
    "Windows uninstall: msiexec.exe /X origin-installer.msi /quiet /norestart"
  ]
